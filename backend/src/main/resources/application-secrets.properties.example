# ============================================================================
# TEMPLATE DE SEGREDOS LOCAIS -- este arquivo (.example) PODE ir pro git.
#
# COMO USAR:
#   1. Copie este arquivo para "application-secrets.properties" (mesma pasta,
#      sem o ".example"). Esse novo arquivo esta no .gitignore e NUNCA sobe.
#   2. Preencha os valores reais abaixo.
#   3. Rode o backend com o perfil prod:  SPRING_PROFILES_ACTIVE=prod
#
# Serve SO para testar a conexao com o Azure SQL a partir da sua maquina.
# Em producao (Azure App Service) estes valores vem das variaveis de ambiente,
# nao deste arquivo.
# ============================================================================

# --- Conexao com o Azure SQL Server ---
# Pegue no portal do Azure: banco -> "Connection strings" -> aba JDBC.
AZURE_SQL_URL=jdbc:sqlserver://SEU-SERVIDOR.database.windows.net:1433;database=SEU-BANCO;encrypt=true;trustServerCertificate=false;loginTimeout=30
AZURE_SQL_USER=seu_usuario_admin
AZURE_SQL_PASSWORD=COLE_A_SENHA_AQUI

# --- Segredo do JWT (gere um valor novo, diferente do que vazou) ---
VIENE_JWT_SECRET=

# --- Senha do admin semente padrao ---
VIENE_ADMIN_PASSWORD=

# --- Senhas dos usuarios semente (uma por pessoa; casam com o indice do
#     application.properties). Deixe em branco para nao criar aquele usuario. ---
VIENE_SEED_USER_0_PASSWORD=
VIENE_SEED_USER_1_PASSWORD=
